<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="12dp"
        android:background="#EEFFFFFF"
        android:orientation="horizontal"
        android:padding="6dp">

        <AutoCompleteTextView
            android:id="@+id/searchInput"
            android:completionThreshold="2"
            android:dropDownHeight="wrap_content"
            android:dropDownVerticalOffset="4dp"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:hint="Avusturya'da adres ara"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="21sp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:textColor="#10241B"
            android:textColorHint="#6B766F" />

        <Button
            android:id="@+id/searchButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Ara"
            android:textAllCaps="false" />
    </LinearLayout>

    <Button
        android:id="@+id/offlineMapsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="90dp"
        android:text="Haritalar"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/radarButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="90dp"
        android:text="Radarlar"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/buildings3dButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|end"
        android:layout_marginEnd="14dp"
        android:text="3D"
        android:textAllCaps="false" />

    <LinearLayout
        android:id="@+id/navigationBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="10dp"
        android:layout_marginTop="148dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/navigation_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/maneuverArrowText"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:gravity="center"
            android:text="↗"
            android:textColor="#FFFFFF"
            android:textSize="54sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/navigationRoadText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text="Yol adı"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navigationLaneText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="↑  ↑  ↗"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/navigationDistanceText"
            android:layout_width="94dp"
            android:layout_height="84dp"
            android:background="@drawable/navigation_distance"
            android:gravity="center"
            android:text="160 m"
            android:textColor="#075CA8"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ListView
        android:id="@+id/searchResultsList"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="94dp"
        android:layout_marginEnd="12dp"
        android:background="#F5FFFFFF"
        android:divider="#D0D0D0"
        android:dividerHeight="1dp"
        android:elevation="12dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/displayModeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|start"
        android:layout_marginStart="14dp"
        android:text="Gösterge"
        android:textAllCaps="false" />

    <LinearLayout
        android:id="@+id/arrowModePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFF7F7F7"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/arrowRoadText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Rota oluşturulmadı"
            android:textColor="#10241B"
            android:textSize="28sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/arrow_panel_background"
            android:padding="28dp">

            <ImageView
                android:id="@+id/bigDirectionArrow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Yön oku"
                android:scaleType="fitCenter"
                android:src="@drawable/navigation_arrow_straight" />

        </FrameLayout>

        <TextView
            android:id="@+id/arrowDistanceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="-- m"
            android:textColor="#FFD54F"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/arrowInstructionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="18dp"
            android:text="Önce rota oluştur"
            android:textColor="#10241B"
            android:textSize="25sp" />

        <Button
            android:id="@+id/backToMapButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Haritaya Dön"
            android:textAllCaps="false" />

    </LinearLayout>

    <TextView
        android:id="@+id/destinationText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="150dp"
        android:background="#EFFFFFFF"
        android:padding="12dp"
        android:text="Adres ara veya haritaya uzun bas"
        android:textColor="#10241B"
        android:textSize="15sp" />

    <Button
        android:id="@+id/instructionsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="14dp"
        android:text="Yol Tarifi"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/routeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="88dp"
        android:text="Rota Oluştur"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/clearDestinationButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="24dp"
        android:text="Hedefi Sil"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/locationButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:text="Konumum"
        android:textAllCaps="false" />

</FrameLayout>
