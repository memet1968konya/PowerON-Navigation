<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10241B"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:text="PowerON Telsiz / Radyo"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/stationNameInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="#FFFFFF"
        android:hint="Yayın adı"
        android:padding="12dp"
        android:textColor="#10241B"
        android:textColorHint="#777777" />

    <EditText
        android:id="@+id/streamUrlInput"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        android:hint="Doğrudan ses akışı URL'si"
        android:inputType="textUri"
        android:maxLines="2"
        android:padding="12dp"
        android:textColor="#10241B"
        android:textColorHint="#777777" />

    <TextView
        android:id="@+id/radioStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:padding="14dp"
        android:text="Yayın seçilmedi"
        android:textColor="#FFFFFF"
        android:textSize="19sp" />

    <Button
        android:id="@+id/playRadioButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:text="▶ Dinlemeyi Başlat"
        android:textAllCaps="false"
        android:textSize="18sp" />

    <Button
        android:id="@+id/stopRadioButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:text="■ Durdur"
        android:textAllCaps="false"
        android:textSize="18sp" />

    <Button
        android:id="@+id/closeRadioButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:text="Navigasyona Dön"
        android:textAllCaps="false" />

</LinearLayout>
